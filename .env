GRAPHQL_API_PATH=graphql
GRAPHQL_LOG_LEVEL=info
HEALTH_CHECK_PATH=health
MOCKOON_HOST=mockoon
PROD_HOST=prod
WEBSITE_DOMAIN=localhost

DEV_PORT=3000
GRAPHQL_PORT=4000
MOCKOON_PORT=8080
PLAYWRIGHT_TEST_PORT=9324
PROD_PORT=3001
STORYBOOK_PORT=6006
UI_HOST=0.0.0.0

WEBSITE_URL=http://${WEBSITE_DOMAIN}:${DEV_PORT}

REACT_APP_FALLBACK_LANGUAGE=en
REACT_APP_MAIN_LANGUAGE=uk

REACT_APP_API_URL=https://yourserver.io/api/

# TODO: change API URL to correct one before deploying:
REACT_APP_API_BASE_URL=http://localhost:3000/api
REACT_APP_CONTINUOUS_DEPLOYMENT_HEADER_NAME=no-aws-header-name
REACT_APP_CONTINUOUS_DEPLOYMENT_HEADER_VALUE=no-aws-header-value
REACT_APP_MOCKOON_URL=http://${WEBSITE_DOMAIN}:${MOCKOON_PORT}
REACT_APP_GRAPHQL_URL=http://${WEBSITE_DOMAIN}:${GRAPHQL_PORT}/${GRAPHQL_API_PATH}
REACT_APP_PROD_CONTAINER_API_URL=http://${PROD_HOST}:${PROD_PORT}
REACT_APP_PROD_HOST_API_URL=http://${WEBSITE_DOMAIN}:${PROD_PORT}
REACT_APP_VILNACRM_GMAIL=info@vilnacrm.com
REACT_APP_VILNACRM_PRIVACY_POLICY_URL=https://github.com/VilnaCRM-Org/

# Test-only preloaded auth token for the Lighthouse CI / Playwright seeded-auth runs.
# Ignored unless the build opted in with ENABLE_PRELOADED_AUTH_TOKEN_SEED=true, which only
# the ephemeral `test-harness` image does — a production build compiles the seam out and
# setting this alone can no longer establish a session (issue #158). Keep the key declared,
# even empty, so the bundler always has a value to inline.
REACT_APP_LHCI_PRELOADED_AUTH_TOKEN=

# Observability (issue #115). With an empty DSN, Sentry init is a no-op: the SDK chunk is
# never fetched and local/CI runs stay silent. Populate the release, DSN, and environment
# in deploys.
REACT_APP_RELEASE=
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_ENVIRONMENT=development

# Runtime configuration (issue #145). Read by the production container ENTRYPOINT, which renders
# the inline app-config block of the built HTML shell at start-up — the same image therefore
# serves any environment without a rebuild. Empty means "keep the committed default from
# public/index.html". Feature flags are APP_CONFIG_FLAG_<UPPER_SNAKE_NAME> and take exactly
# "true" or "false"; see docs/feature-flags.md and src/config/runtime/README.md.
APP_CONFIG_API_BASE_URL=
APP_CONFIG_GRAPHQL_URL=
APP_CONFIG_FLAG_FORGOT_PASSWORD=

# Upstream user-service contract versions. GraphQL and OpenAPI are reconciled to a
# single pinned version (scripts/check-contract-versions.sh asserts they match) so the
# generated contract artifacts (src/api/generated/**) cannot silently drift.
GRAPHQL_SCHEMA_VERSION=v2.7.1
GRAPHQL_SCHEMA_URL=https://raw.githubusercontent.com/VilnaCRM-Org/user-service/${GRAPHQL_SCHEMA_VERSION}/.github/graphql-spec/spec

OPENAPI_SPEC_VERSION=v2.7.1
OPENAPI_SPEC_URL=https://raw.githubusercontent.com/VilnaCRM-Org/user-service/${OPENAPI_SPEC_VERSION}/.github/openapi-spec/spec.yaml

MEMLAB_DEBUG=true
MEMLAB_SKIP_WARMUP=true
