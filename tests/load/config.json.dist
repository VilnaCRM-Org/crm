{
  "protocol": "http",
  "host": "prod",
  "port": "3001",
  "params": {
    "headers": {
      "Continuous-Deployment-Header-Name": "continuous-deployment-header-value"
    }
  },
  "delayBetweenScenarios": 30,
  "endpoints": {
    "homepage": {
      "setupTimeoutInMinutes": 10,
      "smoke": {
        "threshold": 1000,
        "rps": 5,
        "vus": 5,
        "duration": 10
      },
      "average": {
        "threshold": 1500,
        "rps": 15,
        "vus": 15,
        "duration": {
          "rise": 5,
          "plateau": 30,
          "fall": 5
        }
      },
      "stress": {
        "threshold": 3000,
        "rps": 75,
        "vus": 75,
        "duration": {
          "rise": 5,
          "plateau": 30,
          "fall": 5
        }
      },
      "spike": {
        "threshold": 5000,
        "rps": 150,
        "vus": 150,
        "duration": {
          "rise": 30,
          "fall": 10
        }
      }
    },
    "signup": {
      "host": "mockoon",
      "port": "8080",
      "setupTimeoutInMinutes": 10,
      "thresholds": {
        "errorRate": {
          "smoke": 0,
          "average": 0,
          "stress": 0.02,
          "spike": 0.05
        },
        "checkPassRate": {
          "smoke": 0.99,
          "average": 0.99,
          "stress": 0.95,
          "spike": 0.9
        }
      },
      "smoke": {
        "threshold": 1500,
        "rps": 3,
        "vus": 3,
        "maxVUs": 10,
        "duration": 10
      },
      "average": {
        "threshold": 2000,
        "rps": 10,
        "vus": 10,
        "maxVUs": 30,
        "duration": {
          "rise": 5,
          "plateau": 30,
          "fall": 5
        }
      },
      "stress": {
        "threshold": 4000,
        "rps": 50,
        "vus": 50,
        "maxVUs": 150,
        "duration": {
          "rise": 5,
          "plateau": 30,
          "fall": 5
        }
      },
      "spike": {
        "threshold": 6000,
        "rps": 100,
        "vus": 100,
        "maxVUs": 300,
        "duration": {
          "rise": 30,
          "fall": 10
        }
      }
    }
  }
}
