{
  "threshold": 0,
  "minTokens": 70,
  "minLines": 5,
  "mode": "mild",
  "format": ["typescript", "tsx", "javascript", "jsx"],
  "path": ["src"],
  "ignore": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.d.ts",
    "**/i18n/**",
    "**/api/generated/**"
  ],
  "reporters": ["consoleFull"],
  "gitignore": true
}
